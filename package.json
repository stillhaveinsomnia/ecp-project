{
  "name": "ecp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "npm run build:bare && expo run:android",
    "ios": "npm run build:bare && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:bare": "tsc -p tsconfig.bare.json && bare-pack --host ios-x86 --host ios-arm --host android-x86 --host android-arm --linked --format bundle.cjs -o ./components/network/bare/bundle.js ./components/network/bare/dist/components/network/bare/index.js && rm -rf ./components/network/bare/dist",
    "node": "tsx ./components/network/hyperswarmNetworkNodeWebsocketServer.ts",
    "hyperswarm-local-bootstrap": "hyperdht --bootstrap --host 127.0.0.1 --port 50000",
    "postinstall": "patch-package && expo prebuild --clean",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "node run-jest-strict.js",
    "coverage": "jest --coverage",
    "lint-staged": "lint-staged",
    "ai-translate": "tsx ./update-translations.ts",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile --strict",
    "desktop": "(cd desktop && npm run dev)",
    "desktop:start": "expo export --platform web --output-dir ./desktop/dist && (cd desktop && npm run start)"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@floating-ui/react-native": "^0.10.10",
    "@jest/globals": "^30.5.1",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react-native": "^14.0.1",
    "@types/gettext-parser": "^9.0.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.18",
    "@types/streamx": "^2.9.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vis.gl/react-maplibre": "^8.1.2",
    "bare-buffer": "^3.7.1",
    "bare-encoding": "^1.0.3",
    "bare-pack": "^2.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-lingui": "^0.14.0",
    "expo": "57",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "fflate": "^0.8.3",
    "get-port": "^7.2.0",
    "gettext-parser": "^9.1.1",
    "husky": "^9.1.7",
    "hyperdht": "^6.33.2",
    "hyperswarm": "^4.17.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "lodash": "^4.18.1",
    "lucide-react-native": "^1.39.0",
    "magic-bytes.js": "^1.13.1",
    "maplibre-gl": "^6.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bare-kit": "^0.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-web-refresh-control": "^1.1.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-qr-code": "^2.2.0",
    "smol-toml": "^1.8.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testTimeout": 10000,
    "moduleNameMapper": {
      "^expo-modules-core(|/.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core$1",
      "hyperswarmNetwork$": "<rootDir>/components/network/hyperswarmNetwork.ts"
    },
    "transform": {},
    "transformIgnorePatterns": [],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.after.ts"
    ]
  },
  "lint-staged": {
    "./**/*.{ts,tsx,js,jsx}": [
      "node run-jest-strict.js --findRelatedTests --coverage --coverageThreshold='{\"global\":{\"lines\":100,\"functions\":100,\"statements\":100}}' --ci"
    ]
  },
  "devDependencies": {
    "babel-plugin-dynamic-import-node": "^2.3.3"
  }
}
